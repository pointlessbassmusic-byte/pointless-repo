[Unit]
Description=sportsbot LIVE maker fill-share test (docs/MAKER_TEST.md)
After=network-online.target
Wants=network-online.target

[Service]
# Installed by hand, never enabled by setup_server.sh: real money.
# Reads the operator's git-ignored copy, not the tracked inert config.
User=sportsbot
WorkingDirectory=/opt/sportsbot
Environment=SPORTSBOT_LIVE=1
ExecStart=/opt/sportsbot/.venv/bin/sportsbot run -c /opt/sportsbot/config/maker_test.local.yaml
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
