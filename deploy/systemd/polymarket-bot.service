[Unit]
Description=Polymarket sports betting bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pointless-repo/polymarket-bot
ExecStart=/opt/pointless-repo/polymarket-bot/.venv/bin/python -m src.main
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
