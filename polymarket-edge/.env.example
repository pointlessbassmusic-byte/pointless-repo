# Copy to .env and fill in. NEVER commit .env.

# The Odds API (https://the-odds-api.com) — sportsbook consensus feed
ODDS_API_KEY=

# Polymarket trading (only needed for --live)
# Polygon wallet private key funded with USDC + POL for gas
POLYMARKET_PRIVATE_KEY=
# Optional: proxy/funder address if using a Polymarket proxy wallet
POLYMARKET_FUNDER_ADDRESS=
