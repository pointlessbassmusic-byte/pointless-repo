# Copy to .env and fill in. NEVER commit .env.

# ---- Global safety switch ----
# Must be exactly "1" AND config mode must be "live" for real orders.
SPORTSBOT_LIVE=0

# ---- Polymarket ----
# Private key of the wallet that trades (hex, no 0x prefix needed by py-clob-client).
# Use a dedicated hot wallet funded only with what the bot may lose.
POLYMARKET_PRIVATE_KEY=
# Funder address (your Polymarket proxy wallet address shown in the UI deposit page).
POLYMARKET_FUNDER=
# Signature type: 0 = EOA, 1 = email/Magic proxy, 2 = browser-wallet proxy.
POLYMARKET_SIGNATURE_TYPE=0
# Optional: pre-derived L2 API creds (else derived from the key at startup).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- Kalshi (for when Kalshi trading is switched on) ----
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM downloaded from Kalshi account settings.
KALSHI_PRIVATE_KEY_PATH=
# demo | prod
KALSHI_ENV=demo

# ---- Data providers (optional) ----
# The Odds API (the-odds-api.com) for the sharp-line CLV harness. Credits are
# metered per call, not per request: free tier 500/month, $59 tier 100k.
ODDS_API_KEY=
# Free-tier keys for live odds/schedules if used.
API_TENNIS_KEY=

# Optional: shadow LLM judgement recorder (sportsbot/signals/judge.py, data only).
# ANTHROPIC_API_KEY=
# Operator alerts (optional): a Discord webhook URL. Fills, risk halts and the
# `sportsbot digest --post` daily lines go here; unset = no alerts. The
# arbitrage desk can post to the same webhook so the phone sees one channel.
SPORTSBOT_DISCORD_WEBHOOK=

# Reddit team-news recorder (sportsbot/signals/reddit.py, DATA ONLY): a free
# "script" app from https://www.reddit.com/prefs/apps (read-only, app-only
# OAuth). REDDIT_USERNAME only goes in the User-Agent, as Reddit's rules ask.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
